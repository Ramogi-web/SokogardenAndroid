<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8E705"
    android:orientation="vertical"
    tools:context=".Signin">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❇️ Signin ❇️"
        android:textSize="47sp"
        android:fontFamily="cursive"
        android:textAlignment="center"
        android:textStyle="bold|italic"
        android:background="@drawable/shape"
        android:textColor="#FFFDFD"/>

<!--    below is a card view-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        android:padding="10dp"
        android:layout_margin="10dp">

<!--        below is a linear layout that shall align contents vertically-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#490">

<!--            below is the email edit text-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="📧 enter email address"
                android:textColorHint="#000"
                android:id="@+id/email"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="@color/white"
                android:padding="11dp"/>

<!--            below is the password edit text-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="🔑 enter password"
                android:textColorHint="#000"
                android:id="@+id/password"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="@color/white"
                android:padding="11dp"/>

<!--            below is the sign in button and its properties-->
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👮 Signin"
                android:textSize="25sp"
                android:padding="10dp"
                android:layout_marginLeft="50dp"
                android:layout_marginRight="50dp"
                android:layout_marginTop="30dp"
                android:textColor="#E1CDD8"
                android:backgroundTint="#051232"
                android:id="@+id/signinBtn" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>